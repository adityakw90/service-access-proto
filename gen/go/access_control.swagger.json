{
  "swagger": "2.0",
  "info": {
    "title": "access_control.proto",
    "description": "Access Control Service provides authorization and subject assignment operations.\nThis service is the main entry point for access control decisions.\n\nThe CheckAccess RPC is called by other services to determine if a subject\n(user, service, or system) is allowed to perform a specific action on a resource.\n\nSubject assignment operations (AssignRole, RevokeRole, ListSubjectRoles)\nmanage which roles are granted to which subjects.",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AccessControlService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/access/check": {
      "post": {
        "summary": "CheckAccess determines if a subject is allowed to perform an action on a resource.",
        "description": "This is the core authorization decision point. The service evaluates the subject's\nassigned roles and their permissions to determine if access should be granted.\n\nThe reason field provides transparency for debugging and audit purposes,\nexplaining why access was granted or denied.",
        "operationId": "AccessControlService_CheckAccess",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/accessCheckAccessResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "CheckAccessRequest contains the parameters for an authorization check.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/accessCheckAccessRequest"
            }
          }
        ],
        "tags": [
          "AccessControlService"
        ]
      }
    },
    "/v1/access/roles/assign": {
      "post": {
        "summary": "AssignRole assigns a role to a subject.\nThe subject can be a user, service, or any entity that needs access.",
        "operationId": "AccessControlService_AssignRole",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/accessAssignRoleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "AssignRoleRequest assigns a role to a subject.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/accessAssignRoleRequest"
            }
          }
        ],
        "tags": [
          "AccessControlService"
        ]
      }
    },
    "/v1/access/roles/revoke": {
      "post": {
        "summary": "RevokeRole removes a role assignment from a subject.",
        "operationId": "AccessControlService_RevokeRole",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/accessRevokeRoleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "RevokeRoleRequest removes a role assignment from a subject.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/accessRevokeRoleRequest"
            }
          }
        ],
        "tags": [
          "AccessControlService"
        ]
      }
    },
    "/v1/access/subjects/{subjectId}/roles": {
      "get": {
        "summary": "ListSubjectRoles retrieves all roles assigned to a subject.\nUseful for auditing and displaying subject permissions.",
        "operationId": "AccessControlService_ListSubjectRoles",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/accessListSubjectRolesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "subjectId",
            "description": "subject_id uniquely identifies the entity.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "subjectType",
            "description": "subject_type categorizes the subject.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "pagination.page",
            "description": "The page number to retrieve",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pagination.limit",
            "description": "The number of items per page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pagination.orderBy",
            "description": "what field to use for ordering",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "pagination.sort",
            "description": "asc or desc",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AccessControlService"
        ]
      }
    }
  },
  "definitions": {
    "accessAssignRoleRequest": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "description": "subject_id uniquely identifies the entity receiving the role."
        },
        "subjectType": {
          "type": "string",
          "description": "subject_type categorizes the subject."
        },
        "roleUid": {
          "type": "string",
          "description": "role_uid identifies which role to assign.\nThe role must exist."
        }
      },
      "description": "AssignRoleRequest assigns a role to a subject."
    },
    "accessAssignRoleResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "success indicates the assignment was successful."
        },
        "roleUid": {
          "type": "string",
          "description": "role_uid confirms which role was assigned."
        },
        "assignedAt": {
          "type": "string",
          "format": "int64",
          "description": "assigned_at is the Unix timestamp when the role was assigned."
        }
      },
      "description": "AssignRoleResponse confirms the role assignment."
    },
    "accessCheckAccessRequest": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "description": "subject_id uniquely identifies the entity requesting access.\nThis could be a user ID, service account ID, or system identifier."
        },
        "subjectType": {
          "type": "string",
          "description": "subject_type categorizes the subject (e.g., \"user\", \"service\", \"system\").\nThis allows for different authorization policies per subject type."
        },
        "resource": {
          "type": "string",
          "description": "resource identifies the domain entity being accessed.\nShould match the resource field in Permission definitions."
        },
        "action": {
          "type": "string",
          "description": "action specifies the operation being performed.\nShould match the action field in Permission definitions."
        }
      },
      "description": "CheckAccessRequest contains the parameters for an authorization check."
    },
    "accessCheckAccessResponse": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "allowed is true if the subject has permission for the requested action."
        },
        "reason": {
          "type": "string",
          "description": "reason provides an explanation for the decision.\nFor granted access: may explain which roles/permissions granted access.\nFor denied access: explains why access was denied (e.g., \"no matching permissions\")."
        }
      },
      "description": "CheckAccessResponse contains the authorization decision."
    },
    "accessListSubjectRolesResponse": {
      "type": "object",
      "properties": {
        "subjectRoles": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/accessSubjectRole"
          },
          "description": "subject_roles is the list of role assignments for this subject."
        },
        "meta": {
          "$ref": "#/definitions/commonMeta",
          "description": "meta contains pagination metadata."
        }
      },
      "description": "ListSubjectRolesResponse returns the subject's roles."
    },
    "accessRevokeRoleRequest": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "description": "subject_id uniquely identifies the entity."
        },
        "subjectType": {
          "type": "string",
          "description": "subject_type categorizes the subject."
        },
        "roleUid": {
          "type": "string",
          "description": "role_uid identifies which role to revoke."
        }
      },
      "description": "RevokeRoleRequest removes a role assignment from a subject."
    },
    "accessRevokeRoleResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "success indicates the revocation was successful."
        },
        "revokedAt": {
          "type": "string",
          "format": "int64",
          "description": "revoked_at is the Unix timestamp when the role was revoked."
        }
      },
      "description": "RevokeRoleResponse confirms the role revocation."
    },
    "accessSubjectRole": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "description": "subject_id identifies the entity."
        },
        "subjectType": {
          "type": "string",
          "description": "subject_type categorizes the subject."
        },
        "roleUid": {
          "type": "string",
          "description": "role_uid identifies the assigned role."
        },
        "assignedAt": {
          "type": "string",
          "format": "int64",
          "description": "assigned_at is the Unix timestamp when the role was assigned."
        }
      },
      "description": "SubjectRole represents a role assigned to a subject."
    },
    "commonMeta": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32",
          "title": "The current page of result"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "title": "The number of items per page"
        },
        "total": {
          "type": "string",
          "format": "int64",
          "title": "The total number of items available"
        },
        "pages": {
          "type": "integer",
          "format": "int32",
          "title": "The total number of pages available"
        }
      },
      "description": "Metadata message for pagination."
    },
    "commonPagination": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32",
          "title": "The page number to retrieve"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "title": "The number of items per page"
        },
        "orderBy": {
          "type": "string",
          "title": "what field to use for ordering"
        },
        "sort": {
          "type": "string",
          "title": "asc or desc"
        }
      },
      "description": "Pagination message for request."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
