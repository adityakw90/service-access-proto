{
  "swagger": "2.0",
  "info": {
    "title": "permission.proto",
    "description": "Permission Service provides CRUD operations for managing access control permissions.\nA permission defines a specific action that can be performed on a resource.\n\nPermissions are the fundamental unit of access control in this system.\nThey are assigned to Groups, and indirectly to Roles through their parent Group.\n\nResource-Action Examples:\n- resource: \"invoices\", action: \"read\" → permission to read invoices\n- resource: \"users\", action: \"write\" → permission to modify users\n- resource: \"settings\", action: \"admin\" → full administrative access",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PermissionService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/permissions": {
      "get": {
        "summary": "ListPermissions returns a paginated list of permissions.",
        "operationId": "PermissionService_ListPermissions",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/permissionListPermissionsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pagination.page",
            "description": "The page number to retrieve",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pagination.limit",
            "description": "The number of items per page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pagination.orderBy",
            "description": "what field to use for ordering",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "pagination.sort",
            "description": "asc or desc",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "PermissionService"
        ]
      },
      "post": {
        "summary": "CreatePermission creates a new permission.",
        "operationId": "PermissionService_CreatePermission",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/permissionCreatePermissionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "CreatePermissionRequest contains the fields needed to create a new permission.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/permissionCreatePermissionRequest"
            }
          }
        ],
        "tags": [
          "PermissionService"
        ]
      }
    },
    "/v1/permissions/{uid}": {
      "get": {
        "summary": "GetPermission retrieves a permission by UID.",
        "operationId": "PermissionService_GetPermission",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/permissionPermission"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uid",
            "description": "uid is the public unique identifier of the permission.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PermissionService"
        ]
      },
      "delete": {
        "summary": "DeletePermission permanently removes a permission.",
        "operationId": "PermissionService_DeletePermission",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/permissionDeletePermissionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uid",
            "description": "uid identifies which permission to delete.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PermissionService"
        ]
      },
      "put": {
        "summary": "UpdatePermission modifies an existing permission.",
        "operationId": "PermissionService_UpdatePermission",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/permissionUpdatePermissionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uid",
            "description": "uid identifies which permission to update.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PermissionServiceUpdatePermissionBody"
            }
          }
        ],
        "tags": [
          "PermissionService"
        ]
      }
    }
  },
  "definitions": {
    "PermissionServiceUpdatePermissionBody": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "description": "resource is the new resource identifier."
        },
        "action": {
          "type": "string",
          "description": "action is the new action identifier."
        },
        "description": {
          "type": "string",
          "description": "description is the new description."
        }
      },
      "description": "UpdatePermissionRequest contains fields to update an existing permission."
    },
    "commonMeta": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32",
          "title": "The current page of result"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "title": "The number of items per page"
        },
        "total": {
          "type": "string",
          "format": "int64",
          "title": "The total number of items available"
        },
        "pages": {
          "type": "integer",
          "format": "int32",
          "title": "The total number of pages available"
        }
      },
      "description": "Metadata message for pagination."
    },
    "commonPagination": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32",
          "title": "The page number to retrieve"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "title": "The number of items per page"
        },
        "orderBy": {
          "type": "string",
          "title": "what field to use for ordering"
        },
        "sort": {
          "type": "string",
          "title": "asc or desc"
        }
      },
      "description": "Pagination message for request."
    },
    "permissionCreatePermissionRequest": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "description": "resource identifies the domain entity (e.g., \"invoices\", \"users\").\nMust be lowercase alphanumeric starting with a letter."
        },
        "action": {
          "type": "string",
          "description": "action specifies the operation (e.g., \"read\", \"write\", \"delete\", \"admin\")."
        },
        "description": {
          "type": "string",
          "description": "description is an optional human-readable explanation."
        }
      },
      "description": "CreatePermissionRequest contains the fields needed to create a new permission."
    },
    "permissionCreatePermissionResponse": {
      "type": "object",
      "properties": {
        "permission": {
          "$ref": "#/definitions/permissionPermission",
          "description": "permission is the newly created permission with its assigned UID."
        },
        "meta": {
          "$ref": "#/definitions/commonMeta",
          "description": "meta contains optional metadata about the operation."
        }
      },
      "description": "CreatePermissionResponse returns the created permission."
    },
    "permissionDeletePermissionResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "success indicates the deletion was successful."
        },
        "message": {
          "type": "string",
          "description": "message provides an optional human-readable confirmation."
        },
        "deletedAt": {
          "type": "string",
          "format": "int64",
          "description": "deleted_at is the Unix timestamp when the permission was deleted."
        }
      },
      "description": "DeletePermissionResponse confirms the deletion."
    },
    "permissionListPermissionsResponse": {
      "type": "object",
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/permissionPermission"
          },
          "description": "permissions is the list of permissions for the current page."
        },
        "meta": {
          "$ref": "#/definitions/commonMeta",
          "description": "meta contains pagination metadata (total, pages, etc.)."
        }
      },
      "description": "ListPermissionsResponse returns a paginated list of permissions."
    },
    "permissionPermission": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "uid is the public unique identifier for this permission.\nThis UUID is used in API requests and remains stable across\ndatabase migrations or internal ID changes."
        },
        "resource": {
          "type": "string",
          "description": "resource identifies the domain entity this permission applies to.\nExamples: \"invoices\", \"users\", \"settings\", \"reports\"\nMust be lowercase alphanumeric with hyphens/underscores."
        },
        "action": {
          "type": "string",
          "title": "action specifies the operation allowed on the resource.\nCommon values: \"read\", \"write\", \"delete\", \"admin\""
        },
        "description": {
          "type": "string",
          "description": "description provides a human-readable explanation of this permission's\nscope and purpose, useful for admin UI display and audit logs."
        },
        "createdAt": {
          "type": "string",
          "format": "int64",
          "description": "created_at is the Unix timestamp (seconds) when this permission was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "int64",
          "description": "updated_at is the Unix timestamp (seconds) of the last modification."
        }
      },
      "description": "Permission represents a granular access control unit.\nIt defines what action can be performed on a specific resource."
    },
    "permissionUpdatePermissionResponse": {
      "type": "object",
      "properties": {
        "permission": {
          "$ref": "#/definitions/permissionPermission",
          "description": "permission is the updated permission with new values."
        },
        "meta": {
          "$ref": "#/definitions/commonMeta",
          "description": "meta contains optional metadata about the operation."
        }
      },
      "description": "UpdatePermissionResponse returns the updated permission."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
